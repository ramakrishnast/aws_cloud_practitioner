# Copy to .env (make run does this for you). Everything except the generator works without a key.

# Claude API key: only needed for the AI question generator.
ANTHROPIC_API_KEY=

# Model used to write questions, and the model used for the second review pass.
CLOUDCERT_MODEL=claude-opus-5-5
CLOUDCERT_VERIFIER_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
CLOUDCERT_EFFORT=high
# 1 = if the model declines a request, let the API retry it on a fallback model
CLOUDCERT_FALLBACKS=1

# Watch question_bank/ and auto-import CSV changes (1/0). Set POLLING=1 on network or Docker mounts.
CLOUDCERT_WATCH=1
CLOUDCERT_WATCH_POLLING=0

# Optional overrides (paths are relative to the repository root)
# CLOUDCERT_DATA_DIR=data
# CLOUDCERT_QUESTION_BANK=question_bank
# CLOUDCERT_EXAMS_CONFIG=config/exams.yaml
